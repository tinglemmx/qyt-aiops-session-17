{
  "apiVersion": 1,
  "policies": [
    {
      "orgId": 1,
      "receiver": "grafana-default-email",
      "group_by": ["grafana_folder", "alertname"],
      "routes": [
        {
          "receiver": "告警信息toDD",
          "object_matchers": [["dingding", "=", "true"]],
          "continue": true
        },
        {
          "receiver": "grafana-default-email",
          "object_matchers": [["email", "=", "true"]]
        }
      ]
    }
  ]
}
